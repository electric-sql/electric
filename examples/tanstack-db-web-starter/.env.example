# Database connection URL for PostgreSQL
# This should match the database configuration in docker-compose.yaml
DATABASE_URL=postgresql://postgres:password@localhost:54321/electric

# Authentication secret - REQUIRED in production
# Generate a strong secret (minimum 32 characters)
BETTER_AUTH_SECRET=

# Electric sync service URL
# Defaults to the local Electric service from docker-compose.yaml,
# which you can start using `pnpm backend:up`
#
# ELECTRIC_URL=http://localhost:30000

# Electric API secret (optional)
# Only needed if your Electric instance runs with ELECTRIC_SECRET set,
# rather than ELECTRIC_INSECURE=true as in docker-compose.yaml.
# See https://electric-sql.com/docs/guides/security
#
# ELECTRIC_SECRET=your-electric-secret
